# ==============================================================================
# CargoFlow — Production Environment Variables Configuration
# ==============================================================================

# ── Cloud Database (PostgreSQL / Neon) ────────────────────────────────────────
# Use your Neon serverless pooled connection string with sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-frost-a50e9766-pooler.us-east-2.aws.neon.tech/cargoflow?sslmode=require"

# ── Redis (Upstash / Managed Redis) ──────────────────────────────────────────
# Used for BullMQ worker and WebSocket Redis adapter
REDIS_URL="rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379"

# ── Authentication Security ───────────────────────────────────────────────────
# Strong cryptographically secure JWT secret (at least 64 characters recommended)
# Generate with: openssl rand -base64 48
JWT_SECRET="generate-a-strong-random-64-character-secret-key-here-for-production"

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="production"
WEB_URL="https://app.cargoflow.com"

# ── Frontend Public Variables (Cloudflare Pages / Workers) ───────────────────
NEXT_PUBLIC_API_URL="https://api.cargoflow.com/api"
NEXT_PUBLIC_WS_URL="https://api.cargoflow.com"

# ── Cloudflare Tunnel (Optional Zero-Trust Origin Deployment) ──────────────────
# Token from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN="your-cloudflare-tunnel-token-here"
