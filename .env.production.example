# ==============================================================================
# CargoFlow — Production Environment Variables Reference
# ==============================================================================
# SECURITY NOTICE:
# - Fill these values in your production host (Docker, Cloudflare, etc.).
# - NEVER expose private secrets (DATABASE_URL, JWT_SECRET, REDIS_URL) in NEXT_PUBLIC_*.
# ==============================================================================

# ==============================================================================
# 🔒 PRIVATE SERVER-SIDE SECRETS (NestJS API & BullMQ Worker Containers)
# ==============================================================================

# 1. Neon Serverless PostgreSQL (Pooled connection string with sslmode=require)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-solitary-frost-a50e9766-pooler.us-east-2.aws.neon.tech/cargoflow?sslmode=require"

# 2. Redis Cache & BullMQ Queue (e.g. Upstash Serverless Redis or self-hosted Redis)
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@your-endpoint.upstash.io:6379"

# 3. Cryptographic JWT Secret (Minimum 64 characters recommended for production)
# Generate with: openssl rand -base64 48
JWT_SECRET="GENERATE_A_SECURE_RANDOM_64_CHARACTER_SECRET_KEY_FOR_PRODUCTION_JWT"

# 4. API Server Runtime Options
PORT=3001
NODE_ENV="production"
WEB_URL="https://cargoflow.com"
CORS_ORIGIN="https://cargoflow.com,https://cargoflow-web.pages.dev"
COOKIE_DOMAIN=".cargoflow.com"
COOKIE_SAMESITE="lax"

# 5. BullMQ Worker Concurrency (Number of concurrent 3D packing engine tasks)
WORKER_CONCURRENCY=4

# 6. Cloudflare Zero-Trust Tunnel Token
# Created at: Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN="YOUR_CLOUDFLARE_TUNNEL_RUNNER_TOKEN"

# ==============================================================================
# 🌐 PUBLIC VARIABLES (Next.js Frontend / Cloudflare Workers Environment)
# ==============================================================================

# Public API URL (Accessible over Cloudflare Tunnel)
NEXT_PUBLIC_API_URL="https://api.cargoflow.com/api"

# Public WebSocket Gateway URL
NEXT_PUBLIC_WS_URL="https://api.cargoflow.com"
