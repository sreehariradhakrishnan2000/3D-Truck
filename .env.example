# ==============================================================================
# CargoFlow Environment Variables Template
# ==============================================================================
# IMPORTANT:
# NEVER commit .env or secrets to version control.
# Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JS.
# Variables without NEXT_PUBLIC_ are strictly server-side / private secrets.
# ==============================================================================

# ==============================================================================
# 🔒 PRIVATE SERVER-SIDE SECRETS (NestJS API & BullMQ Worker Only)
# ==============================================================================

# Database Connection (Neon PostgreSQL with connection pooling & SSL required in prod)
DATABASE_URL="postgresql://cargoflow:cargoflow_dev@localhost:5432/cargoflow"

# Redis Cache & Message Queue (Local Redis or Upstash rediss:// in production)
REDIS_URL="redis://localhost:6379"

# Cryptographic JWT Secret (Generate with: openssl rand -base64 48)
JWT_SECRET="dev-secret-do-not-use-in-production-at-least-32-chars-long"

# API Server Configuration
PORT=3001
NODE_ENV="development"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"

# BullMQ Worker Concurrency
WORKER_CONCURRENCY=4

# Cloudflare Tunnel Token (For exposing API & Web over Cloudflare Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=""

# ==============================================================================
# 🌐 PUBLIC CLIENT-SIDE VARIABLES (Next.js Frontend & Cloudflare Workers)
# ==============================================================================

# REST API Base URL (Accessed by client browser)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# WebSocket Endpoint URL (Accessed by Socket.io client)
NEXT_PUBLIC_WS_URL="http://localhost:3001"
